# 无密钥时明确使用规则演示，不会静默伪装真实模型。
ROCOCOACH_MODE=mock
# 教练页真实调用，使用自己账户可用的模型与地域地址。
LLM_PROVIDER=qwen
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 兼容旧配置：LLM_API_KEY / LLM_MODEL 优先。
OPENAI_API_KEY=
OPENAI_MODEL=
# 其他提供商：deepseek / openai / compatible；按服务商配置地址。
